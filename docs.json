{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Relay",
  "description": "Documentation for Relay - a Mac and iPad dashboard app for live production teams.",
  "colors": {
    "primary": "#3C63EF",
    "light": "#34C8EE",
    "dark": "#3B2FE0"
  },
  "favicon": {
    "light": "https://media.brand.dev/4f3699c0-f0f6-4f3f-9e6d-a05b91512d6f.svg",
    "dark": "https://media.brand.dev/4f3699c0-f0f6-4f3f-9e6d-a05b91512d6f.svg"
  },
  "logo": "/images/relay-mark.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "directory": "card",
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "color": {
          "light": "#3C63EF",
          "dark": "#34C8EE"
        },
        "products": [
          {
            "product": "Get Started",
            "icon": "rocket",
            "description": "Install Relay, learn the core concepts, and build your first dashboard.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "introduction",
                "pages": [
                  "quickstart",
                  "core-concepts",
                  "guides/first-dashboard"
                ]
              }
            ]
          },
          {
            "product": "Building Dashboards",
            "icon": "layout-dashboard",
            "description": "Create tiles, add modules, and run your show in Live Mode.",
            "groups": [
              {
                "group": "Building Dashboards",
                "expanded": true,
                "root": "dashboards/overview",
                "pages": [
                  "dashboards/tiles",
                  "dashboards/modules",
                  "dashboards/live-mode"
                ]
              },
              {
                "group": "Module Guides",
                "pages": [
                  "dashboards/modules/people-planning",
                  "dashboards/modules/audio-visual",
                  "dashboards/modules/video-presentation",
                  "dashboards/modules/wireless",
                  "dashboards/modules/utility"
                ]
              }
            ]
          },
          {
            "product": "Automation",
            "icon": "workflow",
            "description": "Build automations with triggers, actions, utility nodes, and sources.",
            "groups": [
              {
                "group": "Automation",
                "expanded": true,
                "root": "dashboards/automation",
                "pages": [
                  "dashboards/nodes/triggers",
                  "dashboards/nodes/actions",
                  "dashboards/nodes/utilities",
                  "dashboards/nodes/sources"
                ]
              }
            ]
          },
          {
            "product": "Connections",
            "icon": "plug",
            "description": "Connect Planning Center, ProPresenter, consoles, wireless devices, and network protocols.",
            "groups": [
              {
                "group": "Integrations",
                "expanded": true,
                "root": "integrations/overview",
                "pages": [
                  "integrations/planning-center",
                  "integrations/propresenter",
                  "integrations/audio-consoles",
                  "integrations/wireless-devices"
                ]
              },
              {
                "group": "Protocols",
                "expanded": true,
                "root": "protocols/overview",
                "pages": [
                  "protocols/osc",
                  "protocols/midi",
                  "protocols/lan-sharing"
                ]
              }
            ]
          },
          {
            "product": "Account, Support & Beta",
            "icon": "circle-user",
            "description": "Manage your license, permissions, updates, support, and beta workflows.",
            "groups": [
              {
                "group": "Account, Support & Beta",
                "expanded": true,
                "root": "account/license",
                "pages": [
                  "account/permissions",
                  "account/updates",
                  "account/support",
                  "account/beta-features"
                ]
              }
            ]
          },
          {
            "product": "Release Notes",
            "icon": "newspaper",
            "description": "Review the latest Relay release notes and beta release notes.",
            "groups": [
              {
                "group": "Release Notes",
                "expanded": true,
                "root": "changelog",
                "pages": ["changelog", "beta-changelog"]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": []
  },
  "footer": {
    "socials": {}
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
